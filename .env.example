# docker-compose.yaml için ortam değişkenleri şablonu.
# Kullanım: bu dosyayı ".env" adıyla kopyalayın ve değerleri doldurun. .env git'e ve Docker imajına girmez.

# --- Profil: prod (canlı) | docker (yerel deneme, SMS/KBS zorunlu değil)
SPRING_PROFILES_ACTIVE=prod

# --- Veritabanı (zorunlu: POSTGRES_PASSWORD)
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# --- Oturum imzası (zorunlu, en az 32 karakter, rastgele üretin)
JWT_SECRET=

# --- Şema yönetimi: none (önerilen) | validate | update. create/create-drop veri siler, kullanmayın.
JPA_DDL_AUTO=none

# --- Frontend adresi (canlıda https://... ; prod profili yalnız localhost içeren listeyi reddeder)
CORS_ALLOWED_ORIGINS=https://tys.ornek.com
FRONTEND_BASE_URL=https://tys.ornek.com

# --- VatanSMS (prod profilinde zorunlu)
SMS_API_ID=
SMS_API_KEY=
SMS_SENDER=

# --- Jandarma KBS tesis bilgileri (prod profilinde zorunlu)
KBS_TESIS_KODU=0
KBS_KULLANICI_TC=0
KBS_SIFRE=
