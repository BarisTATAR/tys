# docker-compose.yaml için ortam değişkenleri şablonu.
# Kullanım: bu dosyayı ".env" adıyla kopyalayın ve değerleri doldurun. .env git'e ve Docker imajına girmez.

# --- Profil: prod (canlı) | docker (yerel deneme; SMS ve https adresleri zorunlu değil)
SPRING_PROFILES_ACTIVE=prod

# --- Veritabanı (zorunlu: POSTGRES_PASSWORD)
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# --- Oturum imzası (zorunlu, en az 32 karakter). Üretmek için: openssl rand -base64 48
JWT_SECRET=

# --- İşletme KBS şifrelerinin şifreleme anahtarı (zorunlu, 32 bayt Base64). Üretmek için: openssl rand -base64 32
# Değiştirilirse kayıtlı KBS şifreleri çözülemez; yönetici panelinden yeniden girilmesi gerekir.
APP_ENCRYPTION_KEY=

# --- İlk yönetici (yalnız veritabanında hiç yönetici yokken kullanılır; en az 8 karakter, harf + rakam)
ADMIN_USERNAME=
ADMIN_INITIAL_PASSWORD=

# --- Canlı adresler (prod profili https ve localhost dışı adres ister)
CORS_ALLOWED_ORIGINS=https://tys.ornek.com
FRONTEND_BASE_URL=https://tys.ornek.com
# Tarayıcının API'ye eriştiği adres (frontend derlemesi ve CSP için)
API_PUBLIC_URL=https://api.tys.ornek.com

# --- VatanSMS (prod profilinde zorunlu)
SMS_API_ID=
SMS_API_KEY=
SMS_SENDER=

# KBS tesis bilgileri artık işletme başına yönetici panelinden girilir (şifreli saklanır).
